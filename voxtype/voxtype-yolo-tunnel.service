[Unit]
Description=Encrypted Voxtype connection to YOLO
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ConnectTimeout=3 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 -L 127.0.0.1:18080:127.0.0.1:18080 yolo
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
