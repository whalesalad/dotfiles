#!/bin/sh

# Return a stable, high-contrast xterm 256-color index for a hostname.
fallback=208
host=${1:-}

if [ -z "$host" ] || ! command -v cksum >/dev/null 2>&1; then
    printf '%s\n' "$fallback"
    exit 0
fi

short_host=${host%%.*}
normalized_host=$(printf '%s' "$short_host" | LC_ALL=C tr '[:upper:]' '[:lower:]' 2>/dev/null) || normalized_host=

if [ -z "$normalized_host" ]; then
    printf '%s\n' "$fallback"
    exit 0
fi

# One shared seed separates the current hosts without hostname-specific rules.
# Keep this prefix and the palette order stable to preserve assigned colors.
checksum_output=$(printf 'host-color:251:%s' "$normalized_host" | cksum 2>/dev/null) || checksum_output=
checksum=${checksum_output%%[[:space:]]*}

case $checksum in
    ''|*[!0-9]*)
        printf '%s\n' "$fallback"
        exit 0
        ;;
esac

case $((checksum % 7)) in
    0) color=135 ;; # purple
    1) color=205 ;; # pink
    2) color=208 ;; # orange
    3) color=220 ;; # yellow
    4) color=82 ;;  # lime
    5) color=45 ;;  # cyan
    6) color=75 ;;  # blue
esac

printf '%s\n' "$color"
