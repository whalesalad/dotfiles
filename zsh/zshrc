# Resolve this file's real directory even when ~/.zshrc is a symlink.
DOTFILES_ZSH_DIR="${${(%):-%N}:A:h}"

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
export ZSH_CUSTOM="$DOTFILES_ZSH_DIR"

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  # Keep the repo config useful before Oh My Zsh is installed.
  for config_file in "$DOTFILES_ZSH_DIR"/*.zsh(N); do
    source "$config_file"
  done
fi

unset DOTFILES_ZSH_DIR

# Machine-local environment variables (intentionally outside this repository).
[[ -r "$HOME/.env" ]] && source "$HOME/.env"
