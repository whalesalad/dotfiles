[Unit]
Description=Voxtype remote transcription with notified local fallback
Wants=voxtype-yolo-tunnel.service
After=voxtype-yolo-tunnel.service

[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/voxtype-remote-fallback.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
