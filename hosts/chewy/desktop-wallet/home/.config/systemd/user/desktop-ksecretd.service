[Unit]
Description=KDE Secret Service across desktop environments

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/bin/ksecretd
Environment=QT_QPA_PLATFORM=wayland
# Avoid GTK/portal startup dependencies in this credential provider.
Environment=QT_QPA_PLATFORMTHEME=generic QT_NO_XDG_DESKTOP_PORTAL=1
