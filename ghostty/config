# Ghostty Terminal Configuration
# Minimal config inspired by alacritty setup

# Font Configuration
font-family = IBM Plex Mono
font-size = 14

# Window Appearance
background-opacity = 0.95
window-padding-x = 2
window-padding-y = 2

# Theme: ef-winter (from alacritty)
# Colors based on ef-winter theme
background = 0f0b15
foreground = b8c6d5

# Cursor
cursor-color = e580e0
cursor-text = b8c6d5

# Selection
selection-background = 342464
selection-foreground = b8c6d5

# Normal colors
palette = 0=#353554
palette = 1=#ef6560
palette = 2=#6aad0f
palette = 3=#c48052
palette = 4=#6a9fff
palette = 5=#d369af
palette = 6=#6fafdf
palette = 7=#807c9f

# Bright colors
palette = 8=#807c9f
palette = 9=#f47359
palette = 10=#29a444
palette = 11=#df9080
palette = 12=#3f95f6
palette = 13=#e580e0
palette = 14=#4fbaef
palette = 15=#b8c6d5

# Tab Configuration
# Show window chrome with X button and minimize/maximize
# window-decoration = true
# gtk-titlebar = true
# window-theme = dark

# UNBIND EVERYTHING - Let tmux/shell handle everything except these specific keys
# keybind = clear
#
# # Explicitly unbind Ctrl+A for tmux (screen bindings)
# keybind = ctrl+a=unbind
#
# # ONLY these keybindings:
# # Toshy is sending Ctrl+T (not Super+T, not Ctrl+Shift+T)
# keybind = ctrl+t=new_tab
#
# # Cmd+N (Toshy sends Ctrl+N)
# keybind = ctrl+n=new_window
#
# # Cmd+W to close tab (Toshy sends Ctrl+W)
# keybind = ctrl+w=close_surface
#
# # Cmd+1-9 for tab navigation (Toshy sends Ctrl+1-9)
# keybind = ctrl+one=goto_tab:1
# keybind = ctrl+two=goto_tab:2
# keybind = ctrl+three=goto_tab:3
# keybind = ctrl+four=goto_tab:4
# keybind = ctrl+five=goto_tab:5
# keybind = ctrl+six=goto_tab:6
# keybind = ctrl+seven=goto_tab:7
# keybind = ctrl+eight=goto_tab:8
# keybind = ctrl+nine=goto_tab:9
# keybind = ctrl+zero=goto_tab:10

# That's it. Nothing else.

# Terminal behavior
shell-integration = detect
