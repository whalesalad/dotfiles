# Ghostty — jackal (MacBookPro15,1)
# Based on config-linux, tuned for CaskaydiaCove Nerd Font

# Font
font-family = CaskaydiaCove Nerd Font Mono
font-size = 12
font-thicken = true
adjust-cell-height = 10%
adjust-cell-width = -5%

# Window
background-opacity = 0.95
background-blur = true
gtk-titlebar = false
window-padding-x = 6
window-padding-y = 4

# Cursor
cursor-style-blink = true

# Rendering
grapheme-width-method = legacy

# Colors (from config-linux — iTerm2 profile port)
background = #101010
foreground = #ffffff
cursor-color = #ffffff
selection-background = #b5d5ff
selection-foreground = #000000

palette = 0=#000000
palette = 1=#e61313
palette = 2=#6ed908
palette = 3=#ff8000
palette = 4=#3465a4
palette = 5=#75507b
palette = 6=#06989a
palette = 7=#d3d7cf
palette = 8=#555753
palette = 9=#e30e00
palette = 10=#8ae234
palette = 11=#ffa600
palette = 12=#729fcf
palette = 13=#ad7fa8
palette = 14=#34e2e2
palette = 15=#eeeeec

# Shell integration
shell-integration = detect
