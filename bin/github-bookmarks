#!/usr/bin/env bash

set -euo pipefail

readonly PROGRAM_NAME=${0##*/}
readonly OWNERS=(whalesalad titan-research)

error() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
}

die() {
    error "$@"
    exit 1
}

usage() {
    cat <<EOF
Usage: $PROGRAM_NAME [OUTPUT_DIRECTORY]

Export repositories owned by whalesalad and titan-research as a Chromium-
compatible bookmarks HTML file.

The default output directory is your Downloads directory. Each run creates a
new file named github-repositories-bookmarks-YYYYMMDDTHHMMSSZ.html.
EOF
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

default_output_directory() {
    local download_dir

    download_dir=
    if command -v xdg-user-dir >/dev/null 2>&1; then
        download_dir=$(xdg-user-dir DOWNLOAD 2>/dev/null) || download_dir=
    fi
    if [[ -z $download_dir ]]; then
        download_dir=$HOME/Downloads
    fi

    printf '%s\n' "${download_dir%/}"
}

if (( $# > 1 )); then
    usage >&2
    exit 2
fi

case ${1:-} in
    -h|--help)
        usage
        exit 0
        ;;
esac

require_command gh
require_command jq

output_dir=${1:-$(default_output_directory)}
[[ -d $output_dir ]] || die "output directory does not exist: $output_dir"

total=0
repo_documents=()
for owner in "${OWNERS[@]}"; do
    error "fetching repositories for $owner"
    owner_json=$(gh repo list "$owner" --limit 1000 --json name,url) ||
        die "failed to fetch repositories for $owner"

    jq -e --arg owner "$owner" '
        length > 0 and
        all(.[].name; type == "string" and length > 0) and
        all(.[].url;
            type == "string" and
            (ascii_downcase | startswith("https://github.com/" + ($owner | ascii_downcase) + "/"))
        )
    ' <<<"$owner_json" >/dev/null || die "GitHub returned invalid repository data for $owner"

    owner_count=$(jq 'length' <<<"$owner_json")
    total=$((total + owner_count))
    repo_documents+=("$owner_json")
done

generated_at=$(date +%s)
filename_timestamp=$(date -u +%Y%m%dT%H%M%SZ)
output_file=${output_dir%/}/github-repositories-bookmarks-$filename_timestamp.html

umask 022
set -o noclobber
exec 3>"$output_file" || die "refusing to overwrite existing file: $output_file"
set +o noclobber

{
    cat <<'EOF'
<!DOCTYPE NETSCAPE-Bookmark-file-1>
<!-- This file was generated by github-bookmarks. -->
<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">
<TITLE>GitHub Repositories</TITLE>
<H1>GitHub Repositories</H1>
<DL><p>
    <DT><H3>GitHub Repositories</H3>
    <DL><p>
EOF

    for index in "${!OWNERS[@]}"; do
        owner=${OWNERS[$index]}
        printf '        <DT><H3>%s</H3>\n' "$owner"
        printf '        <DL><p>\n'
        jq -r --arg generated_at "$generated_at" '
            sort_by(.name | ascii_downcase)[] |
            "            <DT><A HREF=\"\(.url | @html)\" ADD_DATE=\"\($generated_at)\">\(.name | @html)</A>"
        ' <<<"${repo_documents[$index]}"
        printf '        </DL><p>\n'
    done

    cat <<'EOF'
    </DL><p>
</DL><p>
EOF
} >&3
exec 3>&-

printf 'Wrote %d bookmarks to:\n  %s\n' "$total" "$output_file"
